# Publish only this reviewed source tree. Runtime archives never belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/continuity.py
!/install.py
!/INSTALL.ps1
!/templates/
!/templates/**
!/tests/
!/tests/**
!/examples/
!/examples/handoff.example.json
!/.github/
!/.github/**

**/__pycache__/
**/*.py[cod]
**/test-work-*/
**/sessions/
**/snapshots/
**/reports/
**/environment/
**/requests/
**/memories/
**/memories_v2/
**/install-backups/
**/update-backups/
**/*.sqlite*
**/*.db*
**/*.jsonl*
**/.env
**/.env.*
**/auth.json
**/config.toml
**/INDEX.md
**/CHECK_REPORT.md
**/*.zip
**/*.log
**/*.pem
**/*.key
**/*.pfx
**/*.p12
